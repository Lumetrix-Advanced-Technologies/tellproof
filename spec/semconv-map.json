      "gen_ai.response.model"
    ],
    "input_tokens": [
      "gen_ai.usage.input_tokens",
      "gen_ai.usage.prompt_tokens"
    ],
    "output_tokens": [
      "gen_ai.usage.output_tokens",
      "gen_ai.usage.completion_tokens"
    ],
    "operation": [
      "gen_ai.operation.name",
      "llm.request.type"
    ],
    "region": [
      "cloud.region",
      "aws.region"
    ],
    "agent_slot": [
      "gen_ai.agent.name"
    ],
    "prompt_name": [
      "tellproof.prompt.name",
      "plumbline.prompt.name"
    ],
    "prompt_version": [
      "tellproof.prompt.version",
      "plumbline.prompt.version"
    ],
    "pii_marker": [
